#!/bin/bash
# systemd-sleep hook для тачскрина FTSC1000.
# Перед сном отцепляем только тачскрин, чтобы ядро не поднимало его, пока
# шина Intel LPSS ещё не устоялась; после пробуждения — восстанавливаем.
case "${1:-}" in
    pre)  /usr/local/bin/ftsc1000-touch-init.sh suspend ;;
    post) /usr/local/bin/ftsc1000-touch-init.sh resume ;;
esac
