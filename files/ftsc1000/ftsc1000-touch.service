[Unit]
Description=Re-initialize FocalTech FTSC1000 touchscreen (Huawei MateBook 14)
Documentation=https://github.com/drkhn1234/huawei-touchscreen-fix
After=systemd-modules-load.service local-fs.target
Wants=systemd-modules-load.service
ConditionPathExists=/sys/bus/pci/devices/0000:00:15.1

[Service]
Type=simple
EnvironmentFile=-/etc/default/ftsc1000-touch
ExecStart=/usr/local/bin/ftsc1000-touch-init.sh
# Устройство может стать готовым не сразу: до 5 попыток с растущей задержкой.
# Если не вышло — пробуем ещё раз позже, не блокируя загрузку.
Restart=on-failure
RestartSec=60
StartLimitIntervalSec=600
StartLimitBurst=5
Nice=10

[Install]
WantedBy=multi-user.target
